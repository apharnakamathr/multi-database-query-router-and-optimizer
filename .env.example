# Postgres
POSTGRES_USER=router
POSTGRES_PASSWORD=router_pw
POSTGRES_DB=router_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Vector dims used for the pgvector embedding column (kept small so it runs
# fast on a laptop without a real embedding model; swap in a real encoder
# like sentence-transformers later and update sql/init.sql accordingly)
EMBEDDING_DIM=32

# --- Phase 6: PgBouncer pooling -----------------------------------------
# The router and workload/retrain scripts connect here instead of directly
# to Postgres. Leave unset to bypass pooling and hit Postgres directly.
PGBOUNCER_HOST=localhost
PGBOUNCER_PORT=6432

# --- Phase 5: NL-to-query (Claude API) ----------------------------------
# Required for POST /nl-query to actually translate queries with Claude;
# without it, /nl-query still works but silently falls back to the canned
# demo query per backend (same behavior as /route).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Phase 6: dashboard / API hardening ---------------------------------
CORS_ORIGINS=*
DASHBOARD_API_BASE_URL=http://localhost:8000
