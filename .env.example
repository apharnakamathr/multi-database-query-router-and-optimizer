# Postgres
# These are local-dev-only placeholder credentials, safe to keep as-is.

POSTGRES_USER=router
POSTGRES_PASSWORD=changeme_local_dev_only
POSTGRES_DB=router_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# ^ If port 5432 is already taken on your machine (e.g. a local Postgres
# install), remap it in docker-compose.yml (e.g. "5433:5432") and set the
# same number here.

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Vector dims used for the pgvector embedding column (kept small so it runs
# fast on a laptop without a real embedding model; swap in a real encoder
# like sentence-transformers later and update sql/init.sql accordingly)
EMBEDDING_DIM=32

# PgBouncer pooling: the router and workload/retrain scripts connect here
# instead of directly to Postgres. Leave unset to bypass pooling and hit
# Postgres directly.
PGBOUNCER_HOST=localhost
PGBOUNCER_PORT=6432

# Dashboard / API
CORS_ORIGINS=*
DASHBOARD_API_BASE_URL=http://localhost:8000
